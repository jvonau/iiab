#!/bin/bash

DEFAULT_VARS_FILE=/opt/iiab/iiab/vars/default_vars.yml
LOCAL_VARS_FILE=/etc/iiab/local_vars.yml
IIAB_STATE_FILE=/etc/iiab/iiab_state.yml
IIAB_INI_FILE=/etc/iiab/iiab.ini
UNINSTALL=false
REINSTALL=false
FORCE_REINSTALL=false
UPGRADE=false
ASSUME_YES=false
ADD=false
CHECK=false
STATUS=false
ROLES=()
EXTRA_VARS='{"skip_role_on_error":False,'
INVENTORY=ansible_hosts
PLAYBOOK=run-roles-tmp.yml

if [ ! -f iiab-stages.yml ]; then
    echo "Exiting: IIAB Playbook not found."
    echo "Please run this in /opt/iiab/iiab (top level of the git repo)."
    exit 1
fi

. scripts/runrole-common.sh

usage() {
    cat <<'EOF'
Usage: ./runroles [options] <role> [role ...]

Apply one or more roles using /etc/iiab/local_vars.yml. Runs are repeatable:
roles are installed if missing, upgraded if needed, and otherwise only
reconfigured.

Options:
  -y, --yes             Do not ask for confirmation
  -a, --add             Run the roles even if '*_install: False'
      --apply           Apply settings (the default)
      --reinstall       Reinstall the programs (supported by every role)
      --upgrade         Upgrade (roles that implement 'upgrade')
      --force-reinstall Reinstall and reset dependencies, caches, and settings (roles that implement 'force_reinstall')
      --uninstall       Uninstall the programs (roles that implement 'uninstall')
      --check           Best-effort Ansible check mode (--check --diff)
      --status          Show installed/desired state without changing anything
  -h, --help            Show this help

Examples:
  ./runroles zimantic kiwix
  ./runroles --reinstall zimantic calibre-web
  ./runroles --upgrade zimantic
  ./runroles --uninstall zimantic
EOF
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --apply)
            ;;    # Explicit apply is the default behavior
        --reinstall)
            REINSTALL=true
            EXTRA_VARS="$EXTRA_VARS\"reinstall\":True,"
            ;;
        --force-reinstall)
            REINSTALL=true
            FORCE_REINSTALL=true
            EXTRA_VARS="$EXTRA_VARS\"reinstall\":True,\"force_reinstall\":True,"
            ;;
        --upgrade)
            UPGRADE=true
            EXTRA_VARS="$EXTRA_VARS\"upgrade\":True,"
            ;;
        --uninstall)
            UNINSTALL=true
            EXTRA_VARS="$EXTRA_VARS\"uninstall\":True,"
            ;;
        -y|--yes)
            ASSUME_YES=true
            ;;
        -a|--add)
            ADD=true
            ;;
        --check)
            CHECK=true
            ;;
        --status)
            STATUS=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Unknown option: $1"
            echo
            usage
            exit 1
            ;;
        *)
            ROLES+=("$1")
            ;;
    esac
    shift
done

if [[ ${#ROLES[@]} -eq 0 ]]; then
    usage
    exit 1
fi

if $UNINSTALL && ($REINSTALL || $UPGRADE || $ADD); then
    echo "--uninstall cannot be combined with --add, --reinstall, --upgrade, or --force-reinstall."
    exit 1
fi

if $REINSTALL && $UPGRADE; then
    echo "--reinstall and --force-reinstall cannot be combined with --upgrade."
    exit 1
fi

if $CHECK && $UNINSTALL; then
    echo "--check cannot be combined with --uninstall."
    echo "Use --status to inspect the roles without changing anything."
    exit 1
fi

if $CHECK && $REINSTALL; then
    echo "--check cannot be combined with --reinstall or --force-reinstall."
    echo "Use --status to inspect the roles without changing anything."
    exit 1
fi

if $STATUS && ($UNINSTALL || $REINSTALL || $UPGRADE || $ADD || $CHECK); then
    echo "--status is read-only and cannot be combined with --add, --check, --reinstall, --upgrade, or --uninstall."
    exit 1
fi

if $STATUS; then
    for role in "${ROLES[@]}"; do
        status_role "$role"
    done
    exit 0
fi

unsupported=false
for role in "${ROLES[@]}"; do
    if $UNINSTALL && ! role_require_capability "$role" "--uninstall" uninstall; then
        unsupported=true
    fi
    if $UPGRADE && ! role_require_capability "$role" "--upgrade" upgrade; then
        unsupported=true
    fi
    if $FORCE_REINSTALL && ! role_require_capability "$role" "--force-reinstall" force_reinstall; then
        unsupported=true
    fi
done
if $unsupported; then
    exit 1
fi

if [ ! -f "$LOCAL_VARS_FILE" ]; then
    echo -e "\n\e[1mEXITING: /opt/iiab/iiab/runroles REQUIRES $LOCAL_VARS_FILE\e[0m\n" >&2
    exit 1
fi

CHECK_STATE_FILE=""
STATE_BACKUP_FILE=""
cleanup_check_state() {
    if [ -n "$CHECK_STATE_FILE" ]; then
        rm -f "$CHECK_STATE_FILE"
    fi
    cleanup_state_backup
}
trap cleanup_check_state EXIT

if $CHECK; then
    CHECK_STATE_FILE=$(mktemp /tmp/iiab-state.XXXXXX)
    if [ -f "$IIAB_STATE_FILE" ]; then
        cp "$IIAB_STATE_FILE" "$CHECK_STATE_FILE"
    else
        cat > "$CHECK_STATE_FILE" << EOF
# DO *NOT* MANUALLY EDIT THIS, THANKS!
# IIAB installs apps/services; './runroles --uninstall' is only for roles that
# provide the matching extended operation.

EOF
    fi
    EXTRA_VARS="$EXTRA_VARS\"iiab_state_file\":\"$CHECK_STATE_FILE\","
elif ! $UNINSTALL && [ ! -f "$IIAB_STATE_FILE" ]; then
    echo -e "\n\e[1mCreating... $IIAB_STATE_FILE\e[0m"
    cat > "$IIAB_STATE_FILE" << EOF
# DO *NOT* MANUALLY EDIT THIS, THANKS!
# IIAB installs apps/services; './runroles --uninstall' is only for roles that
# provide the matching extended operation.

EOF
fi

if ! command -v ansible > /dev/null; then
    echo -e "\n\e[1mPlease install Ansible, by running:\n\nsudo /opt/iiab/iiab/scripts/ansible\e[0m\n"
    exit 1
fi

PLAYBOOK_ROLES=("${ROLES[@]}")
if $UNINSTALL; then
    PLAYBOOK_ROLES=()
    found=false
    for role in "${ROLES[@]}"; do
        var=$(role_var "$role")
        if [ -f "$IIAB_STATE_FILE" ] && grep -q "^${var}_" "$IIAB_STATE_FILE"; then
            found=true
            PLAYBOOK_ROLES+=("$role")
        else
            echo "$role is not installed; nothing to uninstall."
        fi
    done
    echo

    if ! $found; then
        echo -e "\e[1mERROR: none of the listed roles are installed in $IIAB_STATE_FILE\e[0m"
        echo "Nothing to uninstall."
        exit 1
    fi

    echo -e "\e[1;31mWARNING: --uninstall removes the listed roles and may delete their data and settings.\e[0m"
    confirm_destructive || { echo "Cancelled."; exit 1; }

    backup_state_file || exit 1
    for role in "${PLAYBOOK_ROLES[@]}"; do
        var=$(role_var "$role")
        echo "Uninstalling $role. Deleting from $IIAB_STATE_FILE:"
        grep "^${var}_" "$IIAB_STATE_FILE" | sed 's/^/  /'
        if ! sed -i "/^${var}_/d" "$IIAB_STATE_FILE"; then
            echo "ERROR: could not update $IIAB_STATE_FILE." >&2
            restore_state_file
            exit 1
        fi
    done
    echo "Set the listed roles' '*_install: False' in $LOCAL_VARS_FILE to keep them uninstalled."
    echo
elif $REINSTALL; then
    installed=false
    for role in "${ROLES[@]}"; do
        var=$(role_var "$role")
        if [ -f "$IIAB_STATE_FILE" ] && grep -q "^${var}_" "$IIAB_STATE_FILE"; then
            installed=true
            break
        fi
    done

    # Only ask when this run will actually reset an existing installation.
    if $FORCE_REINSTALL && $installed; then
        echo -e "\e[1;31mWARNING: --force-reinstall may delete the listed roles' data, caches, indexes, and settings where the roles support it.\e[0m"
        confirm_destructive || { echo "Cancelled."; exit 1; }
    fi
    if ! $FORCE_REINSTALL; then
        echo "Use --force-reinstall to also reset dependencies, caches, indexes, and settings where the roles support it."
    fi

    if $installed; then
        backup_state_file || exit 1
    fi
    for role in "${ROLES[@]}"; do
        var=$(role_var "$role")
        if [ -f "$IIAB_STATE_FILE" ] && grep -q "^${var}_" "$IIAB_STATE_FILE"; then
            echo "Reinstalling $role. Deleting from $IIAB_STATE_FILE:"
            grep "^${var}_" "$IIAB_STATE_FILE" | sed 's/^/  /'
            if ! sed -i "/^${var}_/d" "$IIAB_STATE_FILE"; then
                echo "ERROR: could not update $IIAB_STATE_FILE." >&2
                restore_state_file
                exit 1
            fi
        else
            echo "$role is not installed; it will be installed normally."
        fi
    done
    echo
elif $UPGRADE; then
    echo "Upgrading listed role(s)."
    echo
elif ! $ASSUME_YES && ! $CHECK; then
    installed=false
    for role in "${ROLES[@]}"; do
        var=$(role_var "$role")
        if [ -f "$IIAB_STATE_FILE" ] && grep -q "^${var}_" "$IIAB_STATE_FILE"; then
            installed=true
            break
        fi
    done
    if $installed; then
        echo "Applying settings to already-installed role(s) from $LOCAL_VARS_FILE."
        echo "This is safe to repeat."
        echo
    fi
fi

# make working playbook
cp runroles-base.yml $PLAYBOOK

# add desired roles from arguments
for role in "${PLAYBOOK_ROLES[@]}"; do
    echo "    - { role: $role }" >> $PLAYBOOK
    if $ADD; then
        var=$(role_var "$role")
        if ! role_install_enabled "$role"; then
            echo "WARNING: --add sets '${var}_install: True' for $role, for this run only."
        fi
        EXTRA_VARS="$EXTRA_VARS\"${var}_install\":True,"
    fi
done

if ! $CHECK; then
    mkdir -p /etc/ansible/facts.d
    cp scripts/local_facts.fact /etc/ansible/facts.d/local_facts.fact
fi

# Close the JSON object and drop the trailing comma. skip_role_on_error is
# always False here (matching ./runrole), so a rescued role failure cannot make
# ./runroles exit successfully.
EXTRA_VARS="${EXTRA_VARS%,}"
EXTRA_VARS="--extra-vars ${EXTRA_VARS}}"

CMD="ansible-playbook -i $INVENTORY $PLAYBOOK --connection=local $EXTRA_VARS"
if $CHECK; then
    echo -e "\e[1;33mWARNING: --check is best-effort; not all roles are check-mode safe.\e[0m\n"
    CMD="$CMD --check --diff"
fi
echo -e "\e[1mRunning:\e[0m\n\n$CMD\n"
$CMD
STATUS_CODE=$?
if [ "$STATUS_CODE" -ne 0 ]; then
    restore_state_file
    exit "$STATUS_CODE"
fi
